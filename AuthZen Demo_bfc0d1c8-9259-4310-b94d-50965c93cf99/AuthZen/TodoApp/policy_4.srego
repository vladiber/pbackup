# METADATA
# custom:
#   plainid:
#     policyId: a6b7b1d0-b06c-4591-b1e7-c1fac2320cbe
#     name: All users can read user info
#     accessType: Allow
#     policyUse: DYNAMIC_AUTHORIZATION_SERVICE
#     applications: 
#       - id: API-GW
#       - id: 63e2e8d6-440d-4803-8fdc-19e5a911ead1
package policy
import rego.v1

# METADATA
# custom:
#   plainid:
#     kind: DynamicGroup
#     name: AuthZen All Users
#     id: 66975e7b-171d-4030-ba99-f9049e117f1b
#     description: "Predefined Dynamic Group. All Users contains all organization's users defined in the IDP"
dynamic_group(identity) if {
	identity.template == "AuthZen"
}

# METADATA
# custom:
#   plainid:
#     kind: Ruleset
#     name: users
#     id: af108000-8ebc-401a-9743-8970c729b101
ruleset(asset, identity, requestParams, action) if {
	asset.template == "route"
	startswith(asset["path"], "/users/")
	action.id in ["GET"]
}

# METADATA
# custom:
#   plainid:
#     kind: Ruleset
#     name: All
#     id: d35b30a1-b88f-4bce-9e9c-0076f319951d
#     description: "Predefined Ruleset. All Assets contains all created assets defined in the Asset Type"
ruleset(asset, identity, requestParams, action) if {
	asset.template == "user"
	action.id in ["can_read_user"]
}