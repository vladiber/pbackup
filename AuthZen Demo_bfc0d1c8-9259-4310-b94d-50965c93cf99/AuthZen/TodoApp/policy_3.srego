# METADATA
# custom:
#   plainid:
#     policyId: ce0ad1ee-f833-4121-8543-bc1ecd22380a
#     name: Evil can update todos
#     accessType: Allow
#     policyUse: DYNAMIC_AUTHORIZATION_SERVICE
#     applications: 
#       - id: API-GW
#       - id: 63e2e8d6-440d-4803-8fdc-19e5a911ead1
package policy
import rego.v1

# METADATA
# custom:
#   plainid:
#     kind: DynamicGroup
#     name: Evil
#     id: f2837bf5-aff3-414b-9369-f425cf4f798b
dynamic_group(identity) if {
	identity.template == "AuthZen"
	identity["Role"] == "evil_genius"
}

# METADATA
# custom:
#   plainid:
#     kind: Ruleset
#     name: todos
#     id: 6c06d4ce-599b-4cf6-bde6-0259ee5b35cd
ruleset(asset, identity, requestParams, action) if {
	asset.template == "route"
	startswith(asset["path"], "/todos")
	action.id in ["PUT"]
}

# METADATA
# custom:
#   plainid:
#     kind: Ruleset
#     name: All
#     id: 55c3f957-61b5-4146-bd1f-5273158fee4c
#     description: "Predefined Ruleset. All Assets contains all created assets defined in the Asset Type"
ruleset(asset, identity, requestParams, action) if {
	asset.template == "todo"
	action.id in ["can_update_todo"]
}